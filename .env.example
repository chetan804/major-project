# ===========================================================================
# EcoMind-AI — environment configuration template
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
#
# Every value below is read by `backend/app/core/config.py` (Pydantic Settings).
# Secrets must be generated, not invented. Example generators:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="EcoMind-AI"
APP_VERSION="0.1.0"
ENVIRONMENT=development            # development | test | staging | production
DEBUG=true
API_V1_PREFIX="/api/v1"
# Timezone used for presentation-layer conversion only; storage is always UTC.
DEFAULT_TIMEZONE="Asia/Kolkata"
DEFAULT_LOCALE="en-IN"

# ---------------------------------------------------------------------------
# Database (PostgreSQL 16+; PostGIS optional, see infra notes)
# ---------------------------------------------------------------------------
# Async driver (application). Use `postgresql+asyncpg://`.
DATABASE_URL="postgresql+asyncpg://ecomind:ecomind@localhost:5432/ecomind"
# Sync driver (Alembic migrations only).
MIGRATION_DATABASE_URL="postgresql+psycopg2://ecomind:ecomind@localhost:5432/ecomind"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
# Enforce PostgreSQL Row-Level Security as defense-in-depth for tenant isolation.
# Requires the application role to be a non-owner of tenant tables.
DB_ENABLE_RLS=true
# Enable PostGIS-backed geometry columns. When false (default in sandbox),
# the geo layer uses validated NUMERIC lat/lng + haversine SQL fallback.
GEO_ENABLE_POSTGIS=false

# ---------------------------------------------------------------------------
# Authentication / tokens
# ---------------------------------------------------------------------------
# HS256 secret for access tokens. Generate with: openssl rand -base64 64
JWT_SECRET_KEY="CHANGE_ME_generate_a_64_byte_random_secret"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Refresh-token rotation with reuse detection (revokes the whole token family).
REFRESH_TOKEN_ROTATION=true
PASSWORD_MIN_LENGTH=12
# Argon2id parameters (OWASP-aligned defaults).
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=2

# ---------------------------------------------------------------------------
# Cache / queue (Redis 7+)
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"
# `fakeredis` provides an in-process Redis-compatible adapter for dev/test
# where no Redis server is available. Clearly logged at startup as a dev adapter.
REDIS_ADAPTER=redis              # redis | fakeredis
CACHE_TTL_SECONDS=60
RATE_LIMIT_ENABLED=true

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"
# `inline` runs job functions synchronously in-process (dev/test, deterministic).
# `celery` dispatches to a Celery worker (production).
JOB_RUNNER=inline                # inline | celery

# ---------------------------------------------------------------------------
# CORS / security headers
# ---------------------------------------------------------------------------
# Comma-separated. Never use "*" together with credentials in production.
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false               # enable behind TLS in production

# ---------------------------------------------------------------------------
# Object storage (file uploads: waste images, evidence, report exports)
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local           # local | s3 | minio
STORAGE_LOCAL_ROOT="./storage"
STORAGE_MAX_UPLOAD_MB=10
STORAGE_ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp,text/csv,application/pdf"
S3_ENDPOINT_URL=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""

# ---------------------------------------------------------------------------
# AI / LLM provider adapter
# ---------------------------------------------------------------------------
# The assistant works fully offline via the deterministic local provider, which
# only ever phrases data returned by permission-checked tools.
LLM_PROVIDER=local               # local | openai_compatible
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL=""
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1024
# Low-confidence classifications below this threshold are queued for review.
CLASSIFICATION_REVIEW_THRESHOLD=0.70

# ---------------------------------------------------------------------------
# External integration adapters (local deterministic implementations used in dev)
# ---------------------------------------------------------------------------
ROUTING_PROVIDER=local_haversine # local_haversine | osrm | google | mapbox
ROUTING_PROVIDER_BASE_URL=""
ROUTING_PROVIDER_API_KEY=""
WEATHER_PROVIDER=local_synthetic  # local_synthetic | openweather
WEATHER_PROVIDER_API_KEY=""
EMAIL_PROVIDER=console           # console | smtp
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_ADDRESS="no-reply@ecomind.local"
SMS_PROVIDER=noop                # noop | twilio

# ---------------------------------------------------------------------------
# Route optimization
# ---------------------------------------------------------------------------
OPTIMIZER_MAX_SOLVE_SECONDS=10
OPTIMIZER_DEFAULT_AVG_SPEED_KPH=24
OPTIMIZER_ENABLE_TIME_WINDOWS=true
OPTIMIZER_TRAFFIC_FACTOR=1.0     # reserved for traffic-aware routing

# ---------------------------------------------------------------------------
# Telemetry ingestion
# ---------------------------------------------------------------------------
# Shared secret for device gateways posting telemetry.
TELEMETRY_INGEST_API_KEY="CHANGE_ME_device_gateway_key"
# Reject telemetry older than this many days (backfill window).
TELEMETRY_MAX_BACKFILL_DAYS=7
TELEMETRY_OFFLINE_THRESHOLD_MINUTES=180
DEDUP_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                  # json | console
REQUEST_ID_HEADER="X-Request-ID"
METRICS_ENABLED=true

# ---------------------------------------------------------------------------
# Development simulator (never enabled in production)
# ---------------------------------------------------------------------------
SIMULATOR_ENABLED=false
SIMULATOR_RANDOM_SEED=1337
SIMULATOR_TIME_COMPRESSION=1.0

# ---------------------------------------------------------------------------
# Frontend (Vite) — exposed to the browser, therefore never place secrets here
# ---------------------------------------------------------------------------
VITE_API_BASE_URL="/api/v1"
VITE_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
VITE_MAP_ATTRIBUTION="© OpenStreetMap contributors"
VITE_DEFAULT_TIMEZONE="Asia/Kolkata"
